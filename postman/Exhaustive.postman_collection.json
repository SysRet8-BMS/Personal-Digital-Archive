{
  "info": {
    "name": "Personal Digital Archive - Exhaustive",
    "description": "Full API coverage: ingest, browse, edit, collections/tags, file retrieval, delete, search, activity, reports, settings, and root scan. Run with the app pointed at an isolated test archive root.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000/api"
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "missingId",
      "value": "2147483000"
    },
    {
      "key": "rootId",
      "value": ""
    },
    {
      "key": "childId",
      "value": ""
    },
    {
      "key": "tagId",
      "value": ""
    },
    {
      "key": "itemTitle",
      "value": "\"\""
    },
    {
      "key": "rootName",
      "value": ""
    },
    {
      "key": "childName",
      "value": ""
    },
    {
      "key": "tagName",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const run = Date.now().toString();",
          "pm.collectionVariables.set('rootName', 'PDA Exhaustive Root ' + run);",
          "pm.collectionVariables.set('childName', 'PDA Exhaustive Child ' + run);",
          "pm.collectionVariables.set('tagName', 'pda-exhaustive-' + run);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Create isolated archive test item",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/items",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "postman/fixtures/exhaustive.txt"
            },
            {
              "key": "title",
              "value": "PDA Exhaustive Fixture"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 item ingested',()=>{pm.response.to.have.status(201);const b=pm.response.json();pm.expect(b.extractionStatus).to.eql('done');pm.collectionVariables.set('itemId',b.itemId);pm.collectionVariables.set('itemTitle',JSON.stringify('PDA Exhaustive Fixture'));});"
            ]
          }
        }
      ]
    },
    {
      "name": "Items",
      "item": [
        {
          "name": "List default page",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/items"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 list', () => { pm.response.to.have.status(200); const b = pm.response.json(); pm.expect(b.items).to.be.an('array'); pm.expect(b.total).to.be.a('number'); if (!pm.collectionVariables.get('itemId') && b.items.length) { pm.collectionVariables.set('itemId', b.items[0].itemId); pm.collectionVariables.set('itemTitle', JSON.stringify(b.items[0].title)); } });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject missing source file",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/items",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"sourcePath\":\"\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('missing source rejected',()=>pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter and paginate",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/items?q=notes&favorite=false&archived=false&limit=5&offset=0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 filtered list', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().items.length).to.be.at.most(5); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid limit",

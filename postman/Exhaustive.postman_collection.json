    {
      "name": "Ingest, search, activity, reports, settings, scan, and delete",
      "item": [
        {
          "name": "Item keyword search",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/search",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"exhaustive API test fixture\",\"type\":\"keyword\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {

    "fast-xml-parser": "^5.12.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "next": "16.2.9",
    "pdfjs-dist": "^6.5.438",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "@types/pg": "8.15.6",
